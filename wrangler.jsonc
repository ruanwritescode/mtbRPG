// Cloudflare config for game.shreddi.bike, used when the project builds from the repository root
// (Cloudflare's default). `npx wrangler deploy` runs the build, then uploads web/dist as static files.
// "name" must match the project name in the Cloudflare dashboard.
{
  "name": "mtbrpg",
  "compatibility_date": "2026-09-01",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "single-page-application"
  }
}
