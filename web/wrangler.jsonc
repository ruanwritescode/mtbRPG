// Cloudflare config for game.shreddi.bike. Cloudflare runs `npm run build`, then `npx wrangler deploy`
// uploads the built site in ./dist as static files (no server code).
// "name" must match the project name in the Cloudflare dashboard.
{
  "name": "mtbrpg",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
